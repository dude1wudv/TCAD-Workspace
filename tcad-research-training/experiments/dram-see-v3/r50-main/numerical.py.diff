-def boundary_ranking(responses, count=2, thresholds_V=(.0025, .005, .01)):
-    """Rank the complete fixed denominator. Missing/failed values cannot be replaced."""
-    ids = [row['response_id'] for row in responses]
-    if len(ids) != len(set(ids)):
-        raise ValueError('Duplicate main response in boundary population')
-    unavailable = [row for row in responses if row['state'] != 'VERIFIED']
-    ranked = []
-    for row in responses:
-        if row['state'] != 'VERIFIED':
-            continue
-        margin = _number(row['M4_V'])
-        distance = min(abs(margin - sign * threshold) for threshold in thresholds_V for sign in (-1, 1))
-        ranked.append({**row, 'distance_V': distance})
-    ranked.sort(key=lambda row: (row['distance_V'], row['event']['condition_id'], row['event']['replicate'], row['stored_bit']))
-    complete = not unavailable and len(ranked) >= count
-    return {'selection_status': 'FROZEN' if complete else 'BLOCKED_UNRESOLVED',
-            'population_count': len(responses), 'unavailable': unavailable,
-            'ranking': ranked, 'selected': ranked[:count] if complete else [],
-            'sorting': ['distance_V', 'condition_id', 'replicate', 'stored_bit']}
