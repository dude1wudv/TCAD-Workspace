(public_cache_headers) {
    @status_json path /status.json /live.json
    header @status_json Cache-Control "no-store, max-age=0"
    @html_entry path / /index.html /docs /docs/ /docs/index.html /status.html /portal.html
    header @html_entry Cache-Control "no-cache"
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

www.xjtu.shop {
    root * /srv/xjtu-shop-site/dist
    @portal_root path /
    rewrite @portal_root /portal.html
    import public_cache_headers
    encode zstd gzip
    file_server
}

xjtu.shop {
    redir https://www.xjtu.shop{uri} 308
}

tcad.xjtu.shop {
    root * /srv/xjtu-shop-site/dist
    import public_cache_headers
    encode zstd gzip
    file_server
}

status.xjtu.shop {
    root * /srv/xjtu-shop-site/dist
    @status_root path /
    rewrite @status_root /status.html
    redir /research https://tcad.xjtu.shop/ 308
    import public_cache_headers
    encode zstd gzip
    file_server
}
